# Vini POS — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.

# ---- Supabase (shared by web + mobile + API) ----
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to a browser or the Expo app.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres direct connection (migrations, local tooling)
SUPABASE_DB_URL=

# ---- Web (Next.js, ViniPOS.co) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Mobile (Expo React Native) ----
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Vini super admin is a normal Supabase Auth user with a row in
# platform_admins — no separate credential store, nothing extra to set here.
